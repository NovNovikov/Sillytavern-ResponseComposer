+/**
+ * Builds an ordinary Chat Completion prompt without starting a generation or
+ * changing the selected preset in the interface. This is intended for callers
+ * that need Prompt Manager composition with a named preset.
+ * @param {object} options
+ * @param {ChatMessage[]} [options.messages] Chat history to include.
+ * @param {string|null} [options.presetName] Chat Completion preset to apply.
+ * @param {string} [options.supplementaryInstruction] Per-request instruction appended after chat history.
+ * @param {string} [options.type] Generation type used for World Info triggering.
+ * @returns {Promise<object[]>}
+ */
+export async function prepareChatCompletionMessages({ messages = chat, presetName = null, supplementaryInstruction = '', type = 'normal' } = {}) {
+    return await withChatCompletionPreset(presetName, async () => {
+        const fields = getCharacterCardFields();
+        const history = Array.isArray(messages) ? messages : chat;
+        const worldInfoChat = history
+            .filter(message => !message?.is_system)
+            .map(message => world_info_include_names ? `${message.name}: ${message.mes}` : message.mes)
+            .reverse();
+        const worldInfo = await getWorldInfoPrompt(worldInfoChat, getMaxPromptTokens(), false, {
+            personaDescription: fields.persona,
+            characterDescription: fields.description,
+            characterPersonality: fields.personality,
+            characterDepthPrompt: fields.charDepthPrompt,
+            scenario: fields.scenario,
+            creatorNotes: fields.creatorNotes,
+            trigger: GENERATION_TYPE_TRIGGERS.includes(type) ? type : 'normal',
+        });
+        const [prompt] = await prepareOpenAIMessages({
+            name2,
+            charDescription: fields.description,
+            charPersonality: fields.personality,
+            scenario: fields.scenario,
+            worldInfoBefore: worldInfo.worldInfoBefore,
+            worldInfoAfter: worldInfo.worldInfoAfter,
+            extensionPrompts: extension_prompts,
+            bias: '',
+            type: 'normal',
+            quietPrompt: '',
+            quietImage: null,
+            cyclePrompt: '',
+            systemPromptOverride: fields.system,
+            jailbreakPromptOverride: fields.jailbreak,
+            messages: setOpenAIMessages(history),
+            messageExamples: setOpenAIMessageExamples(parseMesExamples(fields.mesExamples, false)),
+        // Prompt composition must not re-render Prompt Manager while a block is
+        // running with another preset's temporary in-memory settings.
+        }, true);
+        const instruction = String(supplementaryInstruction ?? '').trim();
+        if (instruction) {
+            prompt.push({ role: 'system', content: instruction, injected: true });
+        }
+        return prompt;
+    });
+}
