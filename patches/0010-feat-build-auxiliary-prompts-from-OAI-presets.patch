+/**
+ * Runs an operation with a named Chat Completion preset applied in memory.
+ * It intentionally does not update form controls or emit preset-change events.
+ * @template T
+ * @param {string|null|undefined} presetName
+ * @param {() => Promise<T>|T} operation
+ * @returns {Promise<T>}
+ */
+export async function withChatCompletionPreset(presetName, operation) {
+    if (!presetName) {
+        return await operation();
+    }
+
+    const presetIndex = openai_setting_names[presetName];
+    const savedPreset = openai_settings[presetIndex];
+    if (!savedPreset) {
+        throw new Error(`OAI Preset "${presetName}" is no longer available.`);
+    }
+
+    const snapshot = structuredClone(oai_settings);
+    const preset = structuredClone(savedPreset);
+    migrateChatCompletionSettings(preset);
+    try {
+        Object.assign(oai_settings, preset, { preset_settings_openai: presetName });
+        return await operation();
+    } finally {
+        for (const key of Object.keys(oai_settings)) {
+            delete oai_settings[key];
+        }
+        Object.assign(oai_settings, snapshot);
+    }
+}
