+/**
+ * Finalizers transform a completed assistant response before its final message/swipe commit.
+ * They are intentionally generic: core does not know which extension registered one.
+ * @type {Set<(context: GenerationFinalizerContext) => Promise<GenerationFinalizerResult|void>|GenerationFinalizerResult|void>}
+ */
+const generationFinalizers = new Set();
+
+const GENERATION_FINALIZER_ERROR = Symbol('generationFinalizerError');
+const RESERVED_GENERATION_EXTRA_KEYS = new Set([
+    'api',
+    'model',
+    'reasoning',
+    'reasoning_duration',
+    'reasoning_signature',
+    'reasoning_phase',
+    'raw_assistant_output',
+    'token_count',
+    'time_to_first_token',
+]);
+
+/**
+ * Registers a handler that can asynchronously transform a completed assistant response.
+ * The returned function unregisters that exact handler.
+ *
+ * A handler receives an immutable snapshot. It may return a replacement text and/or a
+ * namespaced metadata patch; it must not mutate Tavern message objects directly.
+ *
+ * @param {(context: GenerationFinalizerContext) => Promise<GenerationFinalizerResult|void>|GenerationFinalizerResult|void} finalizer
+ * @returns {() => void}
+ */
+export function registerGenerationFinalizer(finalizer) {
+    if (typeof finalizer !== 'function') {
+        throw new TypeError('Generation finalizer must be a function.');
+    }
+
+    generationFinalizers.add(finalizer);
+    return () => generationFinalizers.delete(finalizer);
+}
+
+/**
+ * @typedef {object} GenerationFinalizerContext
+ * @property {string} type
+ * @property {string} text
+ * @property {string} reasoning
+ * @property {string|null} rawAssistantOutput
+ * @property {string} title
+ * @property {number} messageId
+ * @property {number|null} swipeId
+ * @property {AbortSignal} abortSignal
+ * @property {boolean} isStreaming
+ * @property {Readonly<Record<string, unknown>>} extraPatch
+ */
+
+/**
+ * @typedef {object} GenerationFinalizerResult
+ * @property {string} [text]
+ * @property {Record<string, unknown>} [extraPatch]
+ */
+
+function isPlainObject(value) {
+    return value !== null && typeof value === 'object' && !Array.isArray(value) && Object.getPrototypeOf(value) === Object.prototype;
+}
+
+function createGenerationFinalizerError(error) {
+    const finalizerError = error instanceof Error ? error : new Error(String(error));
+    finalizerError[GENERATION_FINALIZER_ERROR] = true;
+    return finalizerError;
+}
+
+function mergeGenerationExtraPatch(currentPatch, nextPatch) {
+    if (!isPlainObject(nextPatch)) {
+        throw new TypeError('Generation finalizer extraPatch must be a plain object.');
+    }
+
+    const mergedPatch = { ...currentPatch };
+    for (const [namespace, value] of Object.entries(nextPatch)) {
+        if (RESERVED_GENERATION_EXTRA_KEYS.has(namespace)) {
+            throw new Error(`Generation finalizer cannot write reserved extra key: ${namespace}`);
+        }
+
+        if (isPlainObject(mergedPatch[namespace]) && isPlainObject(value)) {
+            mergedPatch[namespace] = { ...mergedPatch[namespace], ...structuredClone(value) };
+        } else {
+            mergedPatch[namespace] = structuredClone(value);
+        }
+    }
+
+    return mergedPatch;
+}
+
+/**
+ * Runs finalizers in registration order. Every handler observes the transformed text and
+ * accumulated metadata patch returned by preceding handlers.
+ * @param {Omit<GenerationFinalizerContext, 'text'|'extraPatch'> & { text: string }} context
+ * @returns {Promise<{text: string, extraPatch: Record<string, unknown>}>}
+ */
+async function runGenerationFinalizers(context) {
+    let text = String(context.text ?? '');
+    let extraPatch = {};
+
+    for (const finalizer of generationFinalizers) {
+        if (context.abortSignal?.aborted) {
+            throw createGenerationFinalizerError(new DOMException('Generation was aborted.', 'AbortError'));
+        }
+
+        const finalizerContext = Object.freeze({
+            ...context,
+            text,
+            extraPatch: Object.freeze(structuredClone(extraPatch)),
+        });
+
+        let result;
+        try {
+            result = await finalizer(finalizerContext);
+        } catch (error) {
+            throw createGenerationFinalizerError(error);
+        }
+
+        if (context.abortSignal?.aborted) {
+            throw createGenerationFinalizerError(new DOMException('Generation was aborted.', 'AbortError'));
+        }
+
+        if (result === undefined || result === null) {
+            continue;
+        }
+        if (!isPlainObject(result)) {
+            throw createGenerationFinalizerError(new TypeError('Generation finalizer result must be a plain object.'));
+        }
+        if (result.text !== undefined) {
+            if (typeof result.text !== 'string') {
+                throw createGenerationFinalizerError(new TypeError('Generation finalizer text must be a string.'));
+            }
+            text = result.text;
+        }
+        if (result.extraPatch !== undefined) {
+            try {
+                extraPatch = mergeGenerationExtraPatch(extraPatch, result.extraPatch);
+            } catch (error) {
+                throw createGenerationFinalizerError(error);
+            }
+        }
+    }
+
+    return { text, extraPatch };
+}
+
+function applyGenerationExtraPatch(message, extraPatch) {
+    if (!message || !isPlainObject(extraPatch) || Object.keys(extraPatch).length === 0) {
+        return;
+    }
+
+    message.extra = message.extra && typeof message.extra === 'object' ? message.extra : {};
+    for (const [namespace, value] of Object.entries(extraPatch)) {
+        message.extra[namespace] = structuredClone(value);
+    }
+}
+
+function getGenerationTargetSwipeId(type, targetMessage) {
+    if (Number.isInteger(targetMessage?.swipe_id)) {
+        return targetMessage.swipe_id;
+    }
+
+    return ['normal', 'regenerate'].includes(type) ? 0 : null;
+}
+
+function createGenerationRollbackSnapshot() {
+    return {
+        length: chat.length,
+        lastMessage: chat.length > 0 ? structuredClone(chat[chat.length - 1]) : null,
+    };
+}
+
+async function restoreGenerationRollbackSnapshot(snapshot) {
+    if (!snapshot) {
+        return;
+    }
+
+    cancelDebouncedChatSave();
+    chat.length = snapshot.length;
+    if (snapshot.length > 0 && snapshot.lastMessage) {
+        chat[snapshot.length - 1] = structuredClone(snapshot.lastMessage);
+    }
+    await printMessages();
+}
+
