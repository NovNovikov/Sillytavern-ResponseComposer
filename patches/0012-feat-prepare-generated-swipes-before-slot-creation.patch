From ee4eb6645f6e34bb513bc28622a4b4f7b1fb9f21 Mon Sep 17 00:00:00 2001
From: NovNovikov <113181372+NovNovikov@users.noreply.github.com>
Date: Sat, 17 Oct 2026 00:03:10 +0200
Subject: [PATCH] feat: prepare generated swipes before slot creation


diff --git a/public/script.js b/public/script.js
index 1b91da5d8..ab54b194e 100644
--- a/public/script.js
+++ b/public/script.js
@@ -10440,10 +10440,35 @@ export async function swipe(event, direction, { source, repeated, message = chat
         }
     }
 
-    // Cancel pending save to prevent accidental swipe_id overwrites.
+    // Cancel pending saves and lock swipe input before extensions prepare the
+    // generation. Their setup may change a Connection Profile, which reloads
+    // the chat and may take asynchronous work.
     cancelDebouncedChatSave();
-
     swipeState = SWIPE_STATE.SWIPING;
+
+    // A Connection Profile may change the active regex preset, which reloads
+    // the chat. Give extensions a chance to prepare a generated swipe before
+    // Tavern reserves its new, still-unsaved swipe slot.
+    const currentSwipeId = Number(chat[mesId]?.swipe_id ?? 0);
+    const requestedSwipeId = Number(forceSwipeId ?? currentSwipeId)
+        + (direction === SWIPE_DIRECTION.RIGHT && forceSwipeId == null ? 1 : 0);
+    const willGenerateSwipe = source !== SWIPE_SOURCE.DELETE
+        && source !== SWIPE_SOURCE.BACK
+        && direction === SWIPE_DIRECTION.RIGHT
+        && requestedSwipeId >= (chat[mesId]?.swipes?.length ?? 0)
+        && getOverswipeBehavior(mesId) === OVERSWIPE_BEHAVIOR.REGENERATE;
+    if (willGenerateSwipe) {
+        try {
+            await eventSource.emit(event_types.GENERATION_BEFORE_SWIPE, {
+                messageId: mesId,
+                sourceSwipeId: currentSwipeId,
+            });
+        } catch (error) {
+            swipeState = SWIPE_STATE.NONE;
+            throw error;
+        }
+    }
+
     let generation;
 
     const thisMesDiv = chatElement.children('.mes').filter(`[mesid="${mesId}"]`);
diff --git a/public/scripts/events.js b/public/scripts/events.js
index ad8cafa19..812a30c1f 100644
--- a/public/scripts/events.js
+++ b/public/scripts/events.js
@@ -80,6 +80,7 @@ export const event_types = {
     OPEN_CHARACTER_LIBRARY: 'open_character_library',
     ONLINE_STATUS_CHANGED: 'online_status_changed',
     IMAGE_SWIPED: 'image_swiped',
+    GENERATION_BEFORE_SWIPE: 'generation_before_swipe',
     CONNECTION_PROFILE_LOADED: 'connection_profile_loaded',
     CONNECTION_PROFILE_CREATED: 'connection_profile_created',
     CONNECTION_PROFILE_DELETED: 'connection_profile_deleted',
-- 
