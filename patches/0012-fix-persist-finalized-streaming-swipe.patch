From 23e0620ef6e70af0251dde139a4ccc7c4d23916d Mon Sep 17 00:00:00 2001
From: NovNovikov <113181372+NovNovikov@users.noreply.github.com>
Date: Fri, 16 Oct 2026 19:00:00 +0200
Subject: [PATCH] fix: persist finalized streaming swipe


diff --git a/public/script.js b/public/script.js
index 1b91da5d8..4dfdbf715 100644
--- a/public/script.js
+++ b/public/script.js
@@ -3952,6 +3952,22 @@ class StreamingProcessor {
             message.swipe_info.push(...swipeInfoArray);
         }
 
+        // A streaming swipe has already reserved its active slot before the
+        // finalizer runs. Finalizers can replace message.mes and extend extra,
+        // so persist that finished result in the slot before syncMesToSwipe()
+        // reads the slot back into the visible message.
+        if (Array.isArray(message.swipes) && Number.isInteger(message.swipe_id)) {
+            const activeSwipeId = message.swipe_id;
+            message.swipes[activeSwipeId] = message.mes;
+            message.swipe_info ??= [];
+            message.swipe_info[activeSwipeId] = {
+                send_date: message.send_date,
+                gen_started: message.gen_started,
+                gen_finished: message.gen_finished,
+                extra: structuredClone(message.extra ?? {}),
+            };
+        }
+
         syncMesToSwipe(messageId);
         saveLogprobsForActiveMessage(this.messageLogprobs.filter(Boolean), this.continueMessage);
 
